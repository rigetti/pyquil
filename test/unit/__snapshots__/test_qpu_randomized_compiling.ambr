  '''
  PRAGMA EXTERN merge_zxzxz_unitary_with_paulis_reference_conjugate "(destination : mut REAL[], unitary_angles : REAL[], angle_offset : INTEGER, next_paulis : INTEGER, next_pauli_index : INTEGER, previous_paulis_left : INTEGER, previous_pauli_left_index : INTEGER, previous_paulis_right : INTEGER, previous_pauli_right_index : INTEGER, is_pauli_left : BIT, pauli_conjugates_map : INTEGER[16])"
