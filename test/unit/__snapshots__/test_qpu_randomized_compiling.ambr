  DECLARE unitaries_q1 REAL[6]
  DECLARE unitary_angle_offset INTEGER[1]
  DELAY 0 0.0002
  DELAY 1 0.0002
  CALL prng_set_seed_and_step pauli_seed_q0[0] pauli_seed_q0[0]
  CALL prng_set_seed_and_step pauli_seed_q1[0] pauli_seed_q1[0]
